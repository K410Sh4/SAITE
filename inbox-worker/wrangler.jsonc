{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saite-inbox",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "PREENCHA_O_CLIENT_ID.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saite-inbox-db",
      "database_id": "PREENCHA_O_UUID_D1"
    }
  ],
  "triggers": {
    "crons": ["13 4 * * *"]
  }
}
